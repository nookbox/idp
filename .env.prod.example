

# --- DB ---------------------------------------------------
POSTGRES_USER=auth
POSTGRES_PASSWORD=
POSTGRES_DB=auth

# --- 시크릿 -----------------------------------------------
# 생성: openssl rand -hex 32
BETTER_AUTH_SECRET=

# 최초 어드민 계정 비밀번호 (숫자+특수문자 포함 8자 이상)
SEED_ADMIN_PASSWORD=

# --- 메일 발송 (Resend) -----------------------------------
# OTP 인증 코드 메일이 이걸로 나간다. 없으면 auth 컨테이너가 부팅에서 죽는다
# (조용히 메일만 안 나가는 상태로 배포되는 게 더 나쁘기 때문에 일부러 그렇게 뒀다).
# 발급: https://resend.com → API Keys → Create (Sending access 권한이면 충분)
RESEND_API_KEY=

# 보내는 사람. 형식은 "표시이름 <주소>".
# ⚠️ Resend 에서 도메인을 등록하고 SPF/DKIM DNS 레코드를 넣어 인증(Verified)을
#    끝낸 도메인이어야 한다. 인증 안 된 도메인은 발송이 거부된다.
#    Resend → Domains → Add Domain 에서 나오는 레코드를 Cloudflare DNS 에 추가.
# ⚠️ 인증 코드 메일은 회신받을 일이 없으므로 no-reply 를 쓴다.
EMAIL_FROM=NookBox <no-reply@nook-box.com>

# --- 공개 주소 --------------------------------------------
# 브라우저가 실제로 접속하는 단 하나의 주소.
# issuer 의 근거이고, auth-web 주소이고, CORS 기준이다.
#
# auth-web 과 auth 가 이 오리진을 공유하고 경로로만 나뉜다(터널 ingress 에서 분기):
#   /api/auth/*  → auth:3001
#   그 외         → auth-web:3000
# 이렇게 해야 세션 쿠키가 이 호스트에 host-only 로 묶여서
# 다른 서브도메인(= 이 IdP 를 쓰는 RP 서비스들)로 새지 않는다.
#
# ⚠️ 호스트를 auth-web/auth 로 쪼개지 말 것. 쪼개면 쿠키가 auth 호스트에만
#    저장되고 auth-web 의 서버 컴포넌트가 세션을 못 읽어 로그인 화면으로 되돌아온다.
#    (개발 환경은 localhost 라 포트가 달라도 쿠키가 공유되어 이 증상이 안 보인다)
#
# ⚠️ 이 값은 NEXT_PUBLIC_AUTH_URL 로 JS 번들에 박히므로,
#    바꾸면 auth-web 을 반드시 --build 로 다시 만들어야 한다.
#
# ⚠️ 이 값을 바꾸면 issuer 도 바뀐다(`<PUBLIC_ORIGIN>/api/auth`).
#    이미 등록된 RP 들의 OIDC_ISSUER 설정도 함께 갱신해야 한다.
PUBLIC_ORIGIN=https://id.nook-box.com

# --- 서비스(NOOKBOX 본체) 주소 -----------------------------
# 계정 페이지에서 NOOKBOX 랜딩으로 나가는 링크의 목적지.
# IdP(PUBLIC_ORIGIN)와는 다른 도메인이다.
#
# ⚠️ 이 값은 NEXT_PUBLIC_SERVICE_URL 로 JS 번들에 박히므로,
#    바꾸면 auth-web 을 반드시 --build 로 다시 만들어야 한다.
#
# ⚠️ 아래 NOOK_POST_LOGOUT_REDIRECT_URIS 에도 같은 주소가 들어간다.
#    docker compose 는 env-file 안에서의 변수 참조를 지원하지 않아
#    한 곳으로 합칠 수 없다. 도메인을 바꿀 땐 둘 다 고칠 것.
SERVICE_ORIGIN=https://nook-box.com

# --- RP(클라이언트) 등록값 ---------------------------------
# scripts/seed-oauth-client.ts 가 읽는다. 안 주면 localhost 기본값으로 등록되어
# 운영에서 redirect_uri_mismatch 가 난다.
#
# 콜백 주소 형식은 RP 쪽 auth.ts 의 oauthCallbackUrl 이 만든다:
#   <RP 의 BETTER_AUTH_URL>/api/auth/oauth2/callback/<OIDC_PROVIDER_ID>
#
# dev/prod 를 콤마로 함께 넣어두면 한 client 로 양쪽을 쓴다.
# (서로 다른 "서비스"를 한 client 에 몰지 말 것 — 스크립트 상단 가이드 참고)
NOOK_OAUTH_CALLBACK_URIS=http://localhost:4000/api/auth/oauth2/callback/nook-auth,https://nook-box.com/api/auth/oauth2/callback/nook-auth
NOOK_POST_LOGOUT_REDIRECT_URIS=http://localhost:3030,https://nook-box.com

# IdP 가 back-channel logout 을 POST 할 RP 주소.
# 여기서 로그아웃하면 RP 세션도 같이 끊기게 하는 통지 경로다. 비워두면
# 통지하지 않는다(옵트인) — RP 세션은 자기 만료까지 살아있게 된다.
#
# ⚠️ 브라우저가 아니라 IdP 서버가 부르는 주소다. nookbox 는 같은 docker
#    네트워크(nook-edge)에 있어서 컨테이너 이름으로 바로 닿는다. 터널에
#    경로를 뚫을 필요가 없고, 뚫으면 오히려 외부에 불필요하게 노출된다.
# ⚠️ 콤마 목록이 아니라 단일 URL 이다.
NOOK_BACKCHANNEL_LOGOUT_URI=http://nookbox-server:4000/api/auth/backchannel-logout

# --- Cloudflare Tunnel ------------------------------------
# Zero Trust → Networks → Tunnels → Create a tunnel (Cloudflared)
# 생성 후 표시되는 토큰을 그대로 붙여넣는다. 시크릿이므로 커밋 금지.
CLOUDFLARE_TUNNEL_TOKEN=

# --- 호스트 포트 ------------------------------------------
# 127.0.0.1 에만 바인딩된다. 외부 노출은 터널이 담당하므로
# 여기 값은 서버에서 직접 curl 로 확인할 때만 쓰인다.
WEB_HOST_PORT=8080
AUTH_HOST_PORT=8081
# DB 클라이언트로 붙을 때 쓰는 포트. 127.0.0.1 에만 열린다.
POSTGRES_HOST_PORT=5435

# --- 아바타 파일 저장 위치 (호스트 경로) ---------------------
# 업로드된 프로필 사진이 실제로 쌓이는 폴더. 바인드 마운트라 Finder 로 열리고
# Time Machine / rsync 가 그대로 백업한다.
#
# ⚠️ 레포 안에 두지 말 것. git clean 이나 재클론에 통째로 날아간다.
# ⚠️ DB 백업과 한 쌍이다. 한쪽만 복원하면 user.image_key 가 가리키는 파일이
#    없는 깨진 상태가 된다.
AVATAR_HOST_DIR=/Users/사용자명/nook-data/avatars

RESEND_API_KEY=
