

# --- DB ---------------------------------------------------
POSTGRES_USER=auth
POSTGRES_PASSWORD=
POSTGRES_DB=auth

# --- 시크릿 -----------------------------------------------
# 생성: openssl rand -hex 32
BETTER_AUTH_SECRET=

# 최초 어드민 계정 비밀번호 (숫자+특수문자 포함 8자 이상)
SEED_ADMIN_PASSWORD=

# --- 공개 주소 --------------------------------------------
# 브라우저가 실제로 접속하는 주소. issuer 의 근거이자 CORS 기준이 된다.
# ⚠️ PUBLIC_AUTH_URL 은 NEXT_PUBLIC_AUTH_URL 로 번들에 박히므로
#    이 값을 바꾸면 auth-web 을 반드시 --build 로 다시 만들어야 한다.
# ⚠️ 두 주소는 같은 등록가능도메인(nook-box.com) 아래여야 세션 쿠키가 통한다.
PUBLIC_AUTH_URL=https://auth.nook-box.com
PUBLIC_WEB_URL=https://id.nook-box.com

# --- Cloudflare Tunnel ------------------------------------
# Zero Trust → Networks → Tunnels → Create a tunnel (Cloudflared)
# 생성 후 표시되는 토큰을 그대로 붙여넣는다. 시크릿이므로 커밋 금지.
CLOUDFLARE_TUNNEL_TOKEN=

# --- 호스트 포트 ------------------------------------------
# 127.0.0.1 에만 바인딩된다. 외부 노출은 터널이 담당하므로
# 여기 값은 서버에서 직접 curl 로 확인할 때만 쓰인다.
WEB_HOST_PORT=8080
AUTH_HOST_PORT=8081
