# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Database (Postgres) — users + sessions + OIDC state
# Used by both docker-compose (for container init) and the app (for connection)
POSTGRES_USER=auth
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=auth
DATABASE_URL=postgres://auth:replace-me@localhost:5433/auth

# CORS — Next.js (auth-web) and any client apps
# 쉼표로 여러 origin 구분 가능
CORS_ORIGIN=http://localhost:3000,http://localhost:3030

# better-auth
# Public URL this auth server is reachable at (used for issuer + redirects)
BETTER_AUTH_URL=http://localhost:3001
# Long random string used to sign cookies/tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# auth-web URL — login/consent screens hosted by apps/auth/web
WEB_URL=http://localhost:3000

# Seed 어드민 계정 비밀번호 (숫자+특수문자 포함 8자 이상 필수)
SEED_ADMIN_PASSWORD=replace-me-with-secure-password

# --- 메일 발송 (Resend) -----------------------------------
# OTP 인증 코드 메일이 이걸로 나간다.
# 개발에서는 비워도 서버가 뜬다 — 대신 메일이 안 나가고 OTP 가 서버 콘솔에 찍힌다.
# (NODE_ENV=production 이면 없을 때 부팅이 중단된다)
# 발급: https://resend.com → API Keys → Create (Sending access 권한이면 충분)
RESEND_API_KEY=

# 보내는 사람. 형식은 "표시이름 <주소>".
# ⚠️ Resend 에서 도메인을 등록하고 SPF/DKIM DNS 레코드를 넣어 인증(Verified)을
#    끝낸 도메인이어야 한다. 인증 안 된 도메인은 발송이 거부된다.
# 비워두면 onboarding@resend.dev 로 나가는데, 이 주소는 Resend 가입 계정
# 본인 메일로만 발송된다 (다른 수신자는 거부됨).
EMAIL_FROM=NookBox <no-reply@nook-box.com>
# 아바타 파일 저장 폴더. 없으면 서버가 부팅할 때 만든다.
# 로컬은 레포 안 .data/ 를 쓴다(.gitignore 됨). 운영은 compose 가 /data/avatars 로 준다.
AVATAR_DIR=./.data/avatars
